# Renombra este archivo a .env y edítalo con las variables de entorno

# ============================================

# MODEL CONFIGURATION

# ============================================

MODEL_NAME=yolo-v9-t-256-license-plate-end2end

# Artefacto versionado de modelos (se descarga durante el build).

# Al cambiar de modelo, publicar un release nuevo y actualizar ambos valores.

PLATE_MODELS_URL=https://github.com/jarodsmdev/sifaPlateDetectorBE/releases/download/models-v1/plate-models-v1.tar.gz

PLATE_MODELS_SHA256=7814edec45d8cb2b7a38e92639f82ff336bafc4f6f9c9494cd5fc621982dbca6

# ============================================

# POOL DE PROCESAMIENTO

# ============================================

# Trabajos simultáneos y peticiones esperando en cola.

PLATE_MAX_CONCURRENCY=1
PLATE_MAX_QUEUE=8
PLATE_TIMEOUT_S=5.0

# ============================================

# JWT CONFIGURATION (Autenticación y Autorización)

# ============================================

# Clave HMAC para verificar firmas de tokens JWT

# Debe coincidir con JWT_SECRET del servicio de Auth

JWT_SECRET=tu_clave_secreta_para_jwt

# Emisor válido del token (claim 'iss')

JWT_ISSUER=issuer_para_jwt

# Audiencia válida del token (claim 'aud')

JWT_AUDIENCE=audience_para_jwt

# ============================================

# CANAL INTERNO

# ============================================

# Firma que el gateway adjunta en X-Internal-Key y que ChannelKeyMiddleware exige.

# Idéntica en gateway, auth, core y plate. Vacío = guardia desactivada.

INTERNAL_CHANNEL_KEY=clave_compartida_con_los_servicios
